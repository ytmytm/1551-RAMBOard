diff --git a/vice/src/drive/tcbm/mem1551.c b/vice/src/drive/tcbm/mem1551.c
index cd3f5c7663..2947aac111 100644
--- a/vice/src/drive/tcbm/mem1551.c
+++ b/vice/src/drive/tcbm/mem1551.c
@@ -27,16 +27,23 @@
 #include "vice.h"
 
 #include "drivemem.h"
+#include "driverom.h"
 #include "drivetypes.h"
 #include "glue1551.h"
 #include "mem1551.h"
 #include "tpid.h"
+#include "tcbmrom.h"
 #include "types.h"
 
 
 static uint8_t drive_read_rom(diskunit_context_t *drv, uint16_t address)
 {
-    return drv->cpu->cpu_last_data = drv->rom[address & 0x7fff];
+    return drv->cpu->cpu_last_data = drv->trap_rom[address & 0x7fff];
+}
+
+static uint8_t drive_peek_rom(diskunit_context_t *drv, uint16_t address)
+{
+    return drv->trap_rom[address & 0x7fff];
 }
 
 static uint8_t drive_read_1551ram(diskunit_context_t *drv, uint16_t address)
@@ -77,9 +84,42 @@ static void drive_store_zero(diskunit_context_t *drv, uint16_t address, uint8_t
     drv->drive_ram[(uint32_t)(address & 0xff)] = value;
 }
 
+static uint8_t drive_read_ram(diskunit_context_t *drv, uint16_t address)
+{
+    return drv->cpu->cpu_last_data = drv->drive_ram[address];
+}
+
+static void drive_store_ram(diskunit_context_t *drv, uint16_t address, uint8_t value)
+{
+    drv->cpu->cpu_last_data = value;
+    drv->drive_ram[address] = value;
+}
+
+static uint8_t drive_peek_ram(diskunit_context_t *drv, uint16_t address)
+{
+    return drv->drive_ram[address];
+}
+
+static uint8_t drive_read_free(diskunit_context_t *drv, uint16_t address)
+{
+    return drv->cpu->cpu_last_data;
+}
+
+static void drive_store_free(diskunit_context_t *drv, uint16_t address, uint8_t value)
+{
+    drv->cpu->cpu_last_data = value;
+    return;
+}
+
+static uint8_t drive_peek_free(diskunit_context_t *drv, uint16_t address)
+{
+    return drv->cpu->cpu_last_data;
+}
+
 void mem1551_init(struct diskunit_context_s *drv, unsigned int type)
 {
     drivecpud_context_t *cpud = drv->cpud;
+    unsigned int rom_size;
 
     switch (type) {
     case DRIVE_TYPE_1551:
@@ -87,7 +127,46 @@ void mem1551_init(struct diskunit_context_s *drv, unsigned int type)
         drivemem_set_func(cpud, 0x00, 0x01, drive_read_zero, drive_store_zero, NULL, drv->drive_ram, 0x000207fd);
         drivemem_set_func(cpud, 0x01, 0x08, drive_read_1551ram, drive_store_1551ram, NULL, &drv->drive_ram[0x0100], 0x000207fd);
         drivemem_set_func(cpud, 0x40, 0x80, tpid_read, tpid_store, tpid_peek, NULL, 0);
-        drivemem_set_func(cpud, 0xc0, 0x100, drive_read_rom, NULL, NULL, &drv->trap_rom[0x4000], 0xc000fffd);
+        
+        rom_size = tcbmrom_get_1551_size();
+        
+        if (rom_size == DRIVE_ROM1551_SIZE) {
+            /* 16K ROM: only at 0xc000-0xffff */
+            if (drv->drive_ram8_enabled) {
+                /* Expansion memory enabled: 0x8000-0x9fff is RAM, 0xa000-0xbfff is empty/free, 0xc000-0xffff is ROM */
+                drivemem_set_func(cpud, 0x80, 0xa0, drive_read_ram, drive_store_ram, drive_peek_ram, &drv->drive_ram[0x8000], 0);
+                drivemem_set_func(cpud, 0xa0, 0xc0, drive_read_free, drive_store_free, drive_peek_free, NULL, 0);
+            } else {
+                /* No expansion memory: 0x8000-0xbfff is empty/free, 0xc000-0xffff is ROM */
+                drivemem_set_func(cpud, 0x80, 0xc0, drive_read_free, drive_store_free, drive_peek_free, NULL, 0);
+            }
+            /* ROM at 0xc000-0xffff (16K ROM) */
+            drivemem_set_func(cpud, 0xc0, 0x100, drive_read_rom, NULL, drive_peek_rom, &drv->trap_rom[0x4000], 0xc000fffd);
+        } else if (rom_size == DRIVE_ROM_SIZE) {
+            /* 32K ROM: at 0x8000-0xffff (or 0xa000-0xffff if RAM expansion enabled) */
+            if (drv->drive_ram8_enabled) {
+                /* Expansion memory enabled: 0x8000-0x9fff is RAM, ROM starts at 0xa000 */
+                drivemem_set_func(cpud, 0x80, 0xa0, drive_read_ram, drive_store_ram, drive_peek_ram, &drv->drive_ram[0x8000], 0);
+                /* ROM at 0xa000-0xbfff (offset 0x2000 in trap_rom) */
+                drivemem_set_func(cpud, 0xa0, 0xc0, drive_read_rom, NULL, drive_peek_rom, &drv->trap_rom[0x2000], 0);
+            } else {
+                /* No expansion memory: ROM starts at 0x8000 */
+                drivemem_set_func(cpud, 0x80, 0xa0, drive_read_rom, NULL, drive_peek_rom, drv->trap_rom, 0);
+                /* ROM at 0xa000-0xbfff (offset 0x2000 in trap_rom) */
+                drivemem_set_func(cpud, 0xa0, 0xc0, drive_read_rom, NULL, drive_peek_rom, &drv->trap_rom[0x2000], 0);
+            }
+            /* ROM at 0xc000-0xffff (offset 0x4000 in trap_rom) */
+            drivemem_set_func(cpud, 0xc0, 0x100, drive_read_rom, NULL, drive_peek_rom, &drv->trap_rom[0x4000], 0xc000fffd);
+        } else {
+            /* Fallback: assume 16K ROM if size is unknown */
+            if (drv->drive_ram8_enabled) {
+                drivemem_set_func(cpud, 0x80, 0xa0, drive_read_ram, drive_store_ram, drive_peek_ram, &drv->drive_ram[0x8000], 0);
+                drivemem_set_func(cpud, 0xa0, 0xc0, drive_read_free, drive_store_free, drive_peek_free, NULL, 0);
+            } else {
+                drivemem_set_func(cpud, 0x80, 0xc0, drive_read_free, drive_store_free, drive_peek_free, NULL, 0);
+            }
+            drivemem_set_func(cpud, 0xc0, 0x100, drive_read_rom, NULL, drive_peek_rom, &drv->trap_rom[0x4000], 0xc000fffd);
+        }
         break;
     default:
         break;
