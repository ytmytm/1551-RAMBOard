diff --git a/vice/src/drive/tcbm/tcbmrom.c b/vice/src/drive/tcbm/tcbmrom.c
index f1b52245ce..e8932b68ce 100644
--- a/vice/src/drive/tcbm/tcbmrom.c
+++ b/vice/src/drive/tcbm/tcbmrom.c
@@ -44,12 +44,21 @@ static log_t tcbmrom_log;
 /* If nonzero, the ROM image is available  */
 static unsigned int rom1551_loaded = 0;
 
+/* Size of loaded ROM (0x4000 for 16K, 0x8000 for 32K) */
+static unsigned int rom1551_size = 0;
+
 /* test ROM for existence, size */
 int tcbmrom_load_1551(void)
 {
-    return driverom_test_load("DosName1551", &rom1551_loaded,
-            DRIVE_ROM1551_SIZE, DRIVE_ROM1551_SIZE, "1551",
-            DRIVE_TYPE_1551, NULL);
+    unsigned int size = 0;
+    /* Support both 16K (0x4000) and 32K (0x8000) ROM images */
+    int result = driverom_test_load("DosName1551", &rom1551_loaded,
+            DRIVE_ROM1551_SIZE, DRIVE_ROM_SIZE, "1551",
+            DRIVE_TYPE_1551, &size);
+    if (result == 0 && size > 0) {
+        rom1551_size = size;
+    }
+    return result;
 }
 
 /* setup (=load) the ROM for a given disk unit */
@@ -63,11 +72,17 @@ void tcbmrom_setup_image(diskunit_context_t *unit)
 
             switch (unit->type) {
                 case DRIVE_TYPE_1551:
-                    driverom_load("DosName1551", unit->rom, &loaded,
-                            DRIVE_ROM1551_SIZE, DRIVE_ROM1551_SIZE, "1551",
-                            DRIVE_TYPE_1551, NULL);
-                    /* ROM was loaded to the lower part of the buffer */
-                    memcpy(&(unit->rom[DRIVE_ROM1551_SIZE]), unit->rom, DRIVE_ROM1551_SIZE);
+                    {
+                        unsigned int rom_size = 0;
+                        driverom_load("DosName1551", unit->rom, &loaded,
+                                DRIVE_ROM1551_SIZE, DRIVE_ROM_SIZE, "1551",
+                                DRIVE_TYPE_1551, &rom_size);
+                        if (loaded) {
+                            rom1551_size = rom_size;
+                            /* For 16K ROM: no duplication, ROM is only at 0xc000-0xffff */
+                            /* For 32K ROM: ROM is at 0x8000-0xffff (or 0xa000-0xffff if RAM expansion enabled) */
+                        }
+                    }
                     break;
             }
             /* if loading failed, set rom type to 0 */
@@ -105,3 +120,8 @@ void tcbmrom_init(void)
 {
     tcbmrom_log = log_open("TCBMDriveROM");
 }
+
+unsigned int tcbmrom_get_1551_size(void)
+{
+    return rom1551_size;
+}
